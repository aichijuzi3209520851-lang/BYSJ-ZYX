<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>IotLinkLab</AssemblyName>
    <RootNamespace>IotLinkLab</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>物联网链路调试台</Product>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="System.IO.Ports" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets/banner.jpg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/app-mark.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 运行时窗口图标与界面标识同源: app.ico 必须跟着输出, 否则 Form 只能退回 exe 内嵌图标 -->
    <None Include="assets/app.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets/icons/*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>