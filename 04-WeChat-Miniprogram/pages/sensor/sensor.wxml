<!-- 传感器数据页 -->
<view class="page-bg" aria-hidden="true">
  <image class="page-bg-photo" src="/images/bg-sensor.jpg" mode="aspectFill" />
  <view class="page-bg-scrim"></view>
  <view class="page-bg-glow"></view>
</view>

<view class="container">

  <view class="page-heading">
    <text class="page-heading-title">传感器</text>
    <text class="page-heading-sub">5 项环境参数 · 1.5 秒刷新</text>
  </view>

  <!-- 连接状态栏 -->
  <view class="conn-bar card {{mqttConnected ? 'conn-bar--on' : ''}}">
    <view class="conn-info">
      <view class="pulse-dot {{mqttConnected ? '' : 'conn-dot--off'}}"></view>
      <view class="conn-text">
        <text class="conn-title">{{mqttConnected ? '已连接 EMQX' : (connecting ? '连接中…' : '未连接服务器')}}</text>
        <text class="conn-sub t-caption" wx:if="{{mqttConnected}}">{{mqttTopic}}</text>
      </view>
    </view>
    <view class="conn-actions">
      <button wx:if="{{!mqttConnected && !connecting && mqttTopic}}"
        class="conn-btn conn-btn--config" size="mini" bindtap="showMqttConfig">配置</button>
      <button class="conn-btn {{mqttConnected ? 'conn-btn--ghost' : ''}}" size="mini"
        bindtap="onConnBtnTap">
        {{mqttConnected ? '断开' : (connecting ? '连接中' : (mqttTopic ? '重连' : '配置'))}}
      </button>
    </view>
  </view>

  <!-- 报警横幅(数据以固件上报的 hasAlarm 为准) -->
  <view class="alarm-banner card" wx:if="{{mqttConnected && sensorData.warning}}">
    <image class="alarm-icon" src="/ICON/蜂鸣器-开状态.png" mode="aspectFit" />
    <view class="alarm-text">
      <text class="alarm-title">温室环境报警</text>
      <text class="alarm-detail t-caption">{{sensorData.alarmType || '环境参数超出统一阈值'}}</text>
    </view>
  </view>

  <!-- 数据卡片网格 -->
  <view class="grid">
    <!-- 温度 -->
    <view class="cell card {{sensorData.temperature > thresholds.temperature ? 'cell--alarm' : ''}}">
      <view class="cell-head">
        <view class="cell-icon-wrap">
          <image class="cell-icon"
            src="{{sensorData.temperature > thresholds.temperature ? '/ICON/温度_报警状态.png' : '/ICON/温度.png'}}"
            mode="aspectFit" />
        </view>
        <text class="cell-name">温度</text>
      </view>
      <text class="cell-value">{{sensorData.temperature == null ? '--' : sensorData.temperature}}<text class="cell-unit">°C</text></text>
    </view>

    <!-- 湿度 -->
    <view class="cell card {{sensorData.humidity > thresholds.humidity ? 'cell--alarm' : ''}}">
      <view class="cell-head">
        <view class="cell-icon-wrap">
          <image class="cell-icon"
            src="{{sensorData.humidity > thresholds.humidity ? '/ICON/湿度_报警状态.png' : '/ICON/湿度.png'}}"
            mode="aspectFit" />
        </view>
        <text class="cell-name">空气湿度</text>
      </view>
      <text class="cell-value">{{sensorData.humidity == null ? '--' : sensorData.humidity}}<text class="cell-unit">%RH</text></text>
    </view>

    <!-- 土壤湿度 -->
    <view class="cell card {{sensorData.soilMoisture > thresholds.soilMoisture ? 'cell--alarm' : ''}}">
      <view class="cell-head">
        <view class="cell-icon-wrap">
          <image class="cell-icon"
            src="{{sensorData.soilMoisture > thresholds.soilMoisture ? '/ICON/水位_报警状态.png' : '/ICON/水位.png'}}"
            mode="aspectFit" />
        </view>
        <text class="cell-name">土壤湿度</text>
      </view>
      <text class="cell-value">{{sensorData.soilMoisture == null ? '--' : sensorData.soilMoisture}}<text class="cell-unit">%</text></text>
    </view>

    <!-- 光照强度(仅采集展示, 与固件 Light.h 一致: 不参与报警联动) -->
    <view class="cell card">
      <view class="cell-head">
        <view class="cell-icon-wrap">
          <image class="cell-icon" src="/ICON/光照.png" mode="aspectFit" />
        </view>
        <text class="cell-name">光照强度</text>
      </view>
      <text class="cell-value">{{sensorData.lightPercent == null ? '--' : sensorData.lightPercent}}<text class="cell-unit">%</text></text>
    </view>

    <!-- 空气质量(占满整行) -->
    <view class="cell cell--wide card {{sensorData.airQuality === 'bad' ? 'cell--alarm' : ''}}">
      <view class="cell-icon-wrap cell-icon-wrap--wide">
        <image class="cell-icon" src="{{sensorData.airQuality === 'bad' ? '/ICON/空气质量劣状态.png' : '/ICON/空气质量优状态.png'}}" mode="aspectFit" />
      </view>
      <view class="cell-wide-body">
        <text class="cell-name">空气质量</text>
        <text class="cell-value cell-value--text">{{sensorData.airQuality === 'bad' ? '污染' : (sensorData.airQuality === 'nice' ? '良好' : '--')}}</text>
      </view>
    </view>
  </view>

  <!-- 设备控制入口 -->
  <view class="actuator-entry card" bindtap="goToActuator" hover-class="actuator-entry--hover">
    <view class="actuator-entry-icon-wrap">
      <image class="actuator-entry-icon" src="/ICON/风扇-关状态.png" mode="aspectFit" />
    </view>
    <view class="actuator-entry-body">
      <text class="actuator-entry-title">天窗 / 风扇控制</text>
    </view>
    <text class="actuator-entry-arrow">›</text>
  </view>

  <!-- 更新时间 -->
  <view class="update-row" wx:if="{{lastUpdateTime}}">
    <text class="t-caption">最后更新 {{lastUpdateTime}}</text>
  </view>

  <!-- ==================== 配置弹窗 ==================== -->
  <view class="modal-mask" wx:if="{{showConfig}}" catchtap="hideConfig">
    <view class="modal card" catchtap="stopPropagation">
      <view class="modal-head">
        <text class="t-title">服务器配置</text>
        <text class="modal-close" bindtap="hideConfig">×</text>
      </view>

      <view class="field">
        <text class="field-label">服务器地址</text>
        <input class="field-input" type="text" placeholder="例如 192.168.36.221"
          placeholder-class="field-placeholder" value="{{mqttHost}}" bindinput="onHostInput" />
      </view>

      <view class="field">
        <text class="field-label">WebSocket 端口</text>
        <input class="field-input" type="number" placeholder="EMQX 默认 8083"
          placeholder-class="field-placeholder" value="{{mqttPort}}" bindinput="onPortInput" />
      </view>

      <view class="field">
        <text class="field-label">订阅主题</text>
        <input class="field-input" type="text" placeholder="必填 · 与上位机发布主题一致(默认 green/data)"
          placeholder-class="field-placeholder" value="{{mqttTopic}}" bindinput="onTopicInput" />
      </view>

      <!-- 连接历史: 连接过一次即可在下次直接选用 -->
      <view class="history" wx:if="{{history.length > 0}}">
        <view class="history-head">
          <text class="field-label">连接历史</text>
          <text class="t-caption">点击填入</text>
        </view>
        <view class="history-item" wx:for="{{history}}" wx:key="index"
          data-item="{{item}}" bindtap="onHistoryTap">
          <view class="history-info">
            <text class="history-topic">{{item.topic}}</text>
            <text class="t-caption">{{item.host}}:{{item.port}}</text>
          </view>
          <text class="history-del" catchtap="onHistoryRemove" data-index="{{index}}">移除</text>
        </view>
      </view>

      <view class="modal-foot">
        <button class="btn-ghost" bindtap="hideConfig">取消</button>
        <button class="btn-primary" bindtap="saveConfigAndConnect">保存并连接</button>
      </view>
    </view>
  </view>

</view>
