/* 传感器数据页样式 —— 液态玻璃主题, 卡片底色由 glass 接管层覆盖 */

/* ---------- 连接状态条(单行, 连接后才显示主题) ---------- */
.conn-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  transition: border-color 0.3s ease;
}

/* 已连接: 翡翠绿 tint 玻璃(P15: tint 而非实色) */
.conn-bar--on.conn-bar--on {
  background-color: rgba(20, 135, 92, 0.14);
  border-color: var(--accent-line);
}

.conn-info {
  display: flex;
  align-items: center;
  min-width: 0;
}

.conn-dot--off {
  background-color: var(--ink-tertiary);
  animation: none;
}

.conn-text {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
  min-width: 0;
}

.conn-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-primary);
}

.conn-sub {
  font-size: 26rpx;
  color: var(--ink-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conn-btn {
  flex-shrink: 0;
  min-width: 112rpx;
  min-height: 60rpx;
  margin: 0 0 0 16rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--accent);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: var(--radius-pill);
  line-height: 1;
}

.conn-btn--ghost {
  background-color: rgba(255, 255, 255, 0.5);
  color: var(--alarm);
  border: 1rpx solid var(--alarm-line);
}

.conn-btn::after {
  border: none;
}

/* ---------- 报警横幅(tint 玻璃底色见 glass 接管层) ---------- */
.alarm-banner {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border-color: var(--alarm-line);
}

.alarm-icon {
  width: 56rpx;
  height: 56rpx;
}

.alarm-text {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.alarm-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--alarm);
}

.alarm-detail {
  color: var(--alarm);
  opacity: 0.78;
}

/* ---------- 数据网格 ---------- */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.cell {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 180rpx;
  padding: 24rpx;
  transition: border-color 0.3s ease;
}

/* 温度/湿度主卡: 翡翠绿 tint 玻璃, 与普通卡拉开层级(P15) */
.cell--primary.cell--primary {
  background-color: rgba(20, 135, 92, 0.13);
  border-color: rgba(20, 135, 92, 0.18);
}

/* 报警 tint 优先于主卡 tint(须放在 primary 规则之后, 同特异性后者胜出) */
.cell--alarm.cell--alarm {
  background-color: rgba(185, 71, 61, 0.16);
  border-color: var(--alarm-line);
}

/* 良好态空气质量: 轻绿 tint(报警态由 glass 接管层的 .cell--alarm 覆盖) */
.cell--nice.cell--nice {
  background-color: rgba(20, 135, 92, 0.10);
  border-color: rgba(20, 135, 92, 0.16);
}

.cell-head {
  display: flex;
  align-items: center;
  width: 100%;
}

/* 图标托盘: 半透明白圆 + 顶光内阴影, 融进玻璃材质 */
.cell-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.62);
}

.cell-icon {
  width: 46rpx;
  height: 46rpx;
}

.cell-name {
  margin-left: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink-secondary);
}

.cell-value {
  margin-top: 14rpx;
  font-size: 64rpx;
  font-weight: 600;
  color: var(--ink-primary);
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
  letter-spacing: -1rpx;
}

.cell--alarm .cell-value {
  color: var(--alarm);
}

.cell-value--text {
  font-size: 40rpx;
}

.cell-unit {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--ink-tertiary);
  margin-left: 6rpx;
  letter-spacing: 0;
}

/* 整行卡片(空气质量): 图标托盘在左, 文案在右 */
.cell--wide {
  grid-column: span 2;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  min-height: 0;
  padding: 22rpx 24rpx;
}

.cell-icon-wrap--wide {
  width: 72rpx;
  height: 72rpx;
}

.cell-wide-body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-left: 20rpx;
}

.cell--wide .cell-name {
  margin-left: 0;
}

.cell--wide .cell-value {
  margin-top: 2rpx;
}

/* ---------- 更新时间 ---------- */
.update-row {
  display: flex;
  justify-content: center;
  padding: 28rpx 0 8rpx;
}

/* ---------- 执行器入口 ---------- */
.actuator-entry {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  margin-top: 20rpx;
  transition: transform 0.12s ease;
}

.actuator-entry--hover {
  transform: translateY(2rpx);
}

.actuator-entry-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: rgba(20, 135, 92, 0.14);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.62);
}

.actuator-entry-icon {
  width: 48rpx;
  height: 48rpx;
}

.actuator-entry-body {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
  flex: 1;
}

.actuator-entry-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink-primary);
}

.actuator-entry-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: var(--accent-ink);
  padding: 8rpx 6rpx 8rpx 12rpx;
}

/* ---------- 配置弹窗(strong 档玻璃底见 glass 接管层) ---------- */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(24, 39, 32, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 48rpx;
}

.modal {
  width: 100%;
  max-height: 80vh;
  padding: 40rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.modal-close {
  font-size: 44rpx;
  line-height: 1;
  color: var(--ink-tertiary);
  padding: 8rpx 12rpx;
}

/* ---------- 表单(小控件刻意实色, 保证可读) ---------- */
.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink-secondary);
  margin-bottom: 12rpx;
}

.field-input {
  min-height: 88rpx;
  padding: 0 24rpx;
  background-color: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--border-hair);
  border-radius: var(--radius-inner);
  font-size: 32rpx;
  color: var(--ink-primary);
}

.field-placeholder {
  color: var(--ink-tertiary);
}

/* ---------- 连接历史 ---------- */
.history {
  margin: 8rpx 0 28rpx;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  margin-bottom: 12rpx;
  background-color: rgba(255, 255, 255, 0.6);
  border: 1rpx solid var(--border-hair);
  border-radius: var(--radius-inner);
}

.history-info {
  display: flex;
  flex-direction: column;
}

.history-topic {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink-primary);
}

.history-del {
  font-size: 26rpx;
  color: var(--ink-tertiary);
  padding: 8rpx 12rpx;
}

/* ---------- 弹窗底部按钮 ---------- */
.modal-foot {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.modal-foot .btn-primary,
.modal-foot .btn-ghost {
  flex: 1;
  min-width: 0;   /* 解除 button 默认宽度下限, 两按钮在弹窗内均分 */
  min-height: 80rpx;
  padding: 0;
}
