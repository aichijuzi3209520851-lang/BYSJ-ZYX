<!-- 执行器控制页 -->
<view class="page-bg" aria-hidden="true">
  <image class="page-bg-photo" src="/images/bg-actuator.jpg" mode="aspectFill" />
  <view class="page-bg-scrim"></view>
  <view class="page-bg-glow"></view>
</view>

<view class="container">

  <view class="page-heading">
    <text class="page-heading-title">执行器</text>
  </view>

  <!-- 连接状态栏 -->
  <view class="conn-bar card {{mqttConnected ? 'conn-bar--on' : ''}}">
    <view class="conn-info">
      <view class="pulse-dot {{mqttConnected ? '' : 'conn-dot--off'}}"></view>
      <view class="conn-text">
        <text class="conn-title">{{mqttConnected ? '已连接 EMQX' : (connecting ? '连接中…' : '未连接服务器')}}</text>
        <text class="conn-sub t-caption" wx:if="{{mqttConnected}}">{{mqttTopic}}</text>
      </view>
    </view>
    <button class="conn-btn {{mqttConnected ? 'conn-btn--ghost' : ''}}" size="mini"
      bindtap="{{mqttConnected ? 'disconnectMqtt' : 'showMqttConfig'}}">
      {{mqttConnected ? '断开' : '配置'}}
    </button>
  </view>

  <!-- 控制模式切换 -->
  <view class="card mode-card">
    <view class="mode-head">
      <text class="mode-title">控制模式</text>
    </view>

    <view class="mode-seg">
      <view class="mode-seg-item {{mode === 'auto' ? 'mode-seg-item--on' : ''}}"
        hover-class="mode-seg-hover" bindtap="setMode" data-mode="auto">
        <text>自动联动</text>
      </view>
      <view class="mode-seg-item {{mode === 'manual' ? 'mode-seg-item--on' : ''}}"
        hover-class="mode-seg-hover" bindtap="setMode" data-mode="manual">
        <text>手动控制</text>
      </view>
    </view>
  </view>

  <!-- 设备控制卡片 -->
  <view class="grid">
    <!-- 天窗(舵机) -->
    <view class="device card {{device.servoStatus === 'ON' ? 'device--on' : ''}}">
      <view class="device-icon-wrap">
        <image class="device-icon"
          src="{{device.servoStatus === 'ON' ? '/ICON/窗户-开状态.png' : '/ICON/窗户-关状态.png'}}"
          mode="aspectFit" />
      </view>
      <text class="device-name">天窗</text>
      <view class="device-chip {{device.servoStatus === 'ON' ? 'device-chip--on' : ''}}">
        <view class="chip-dot"></view>
        <text class="chip-text">{{device.servoStatus === 'ON' ? '开启' : (device.servoStatus === 'OFF' ? '关闭' : '待数据')}}</text>
      </view>
      <view class="device-btns">
        <button class="dev-btn dev-btn--open {{mode !== 'manual' ? 'dev-btn--disabled' : ''}}"
          hover-class="dev-btn-hover" bindtap="onWindowOpen">打开</button>
        <button class="dev-btn dev-btn--close {{mode !== 'manual' ? 'dev-btn--disabled' : ''}}"
          hover-class="dev-btn-hover" bindtap="onWindowClose">关闭</button>
      </view>
    </view>

    <!-- 风扇(电机) -->
    <view class="device card {{device.motorStatus === 'ON' ? 'device--on' : ''}}">
      <view class="device-icon-wrap">
        <image class="device-icon"
          src="{{device.motorStatus === 'ON' ? '/ICON/风扇-开状态.png' : '/ICON/风扇-关状态.png'}}"
          mode="aspectFit" />
      </view>
      <text class="device-name">风扇</text>
      <view class="device-chip {{device.motorStatus === 'ON' ? 'device-chip--on' : ''}}">
        <view class="chip-dot"></view>
        <text class="chip-text">{{device.motorStatus === 'ON' ? '运行' : (device.motorStatus === 'OFF' ? '停止' : '待数据')}}</text>
      </view>
      <view class="device-btns">
        <button class="dev-btn dev-btn--open {{mode !== 'manual' ? 'dev-btn--disabled' : ''}}"
          hover-class="dev-btn-hover" bindtap="onFanOn">启动</button>
        <button class="dev-btn dev-btn--close {{mode !== 'manual' ? 'dev-btn--disabled' : ''}}"
          hover-class="dev-btn-hover" bindtap="onFanOff">停止</button>
      </view>
    </view>
  </view>

  <!-- 最近指令 -->
  <view class="card cmd-log">
    <view class="cmd-row">
      <text class="cmd-label">最近指令</text>
      <text class="cmd-value">{{lastCmd ? lastCmd.text : '暂无'}}</text>
    </view>
    <view class="cmd-row" wx:if="{{lastUpdateTime}}">
      <text class="cmd-label">状态更新</text>
      <text class="cmd-value">{{lastUpdateTime}}</text>
    </view>
  </view>

  <!-- ==================== 配置弹窗 ==================== -->
  <view class="modal-mask" wx:if="{{showConfig}}" catchtap="hideConfig">
    <view class="modal card" catchtap="stopPropagation">
      <view class="modal-head">
        <text class="t-title">服务器配置</text>
        <text class="modal-close" bindtap="hideConfig">×</text>
      </view>

      <view class="field">
        <text class="field-label">服务器地址</text>
        <input class="field-input" type="text" placeholder="例如 192.168.36.221"
          placeholder-class="field-placeholder" value="{{mqttHost}}" bindinput="onHostInput" />
      </view>

      <view class="field">
        <text class="field-label">WebSocket 端口</text>
        <input class="field-input" type="number" placeholder="EMQX 默认 8083"
          placeholder-class="field-placeholder" value="{{mqttPort}}" bindinput="onPortInput" />
      </view>

      <view class="field">
        <text class="field-label">数据主题</text>
        <input class="field-input" type="text" placeholder="与上位机发布主题一致(默认 green/data)"
          placeholder-class="field-placeholder" value="{{mqttTopic}}" bindinput="onTopicInput" />
      </view>

      <view class="field">
        <text class="field-label">指令主题(固定)</text>
        <view class="field-static">{{controlTopic}}</view>
      </view>

      <!-- 连接历史(与传感器页共用) -->
      <view class="history" wx:if="{{history.length > 0}}">
        <view class="history-head">
          <text class="field-label">连接历史</text>
          <text class="t-caption">点击填入</text>
        </view>
        <view class="history-item" wx:for="{{history}}" wx:key="index"
          data-item="{{item}}" bindtap="onHistoryTap">
          <view class="history-info">
            <text class="history-topic">{{item.topic}}</text>
            <text class="t-caption">{{item.host}}:{{item.port}}</text>
          </view>
          <text class="history-del" catchtap="onHistoryRemove" data-index="{{index}}">移除</text>
        </view>
      </view>

      <view class="modal-foot">
        <button class="btn-ghost" bindtap="hideConfig">取消</button>
        <button class="btn-primary" bindtap="saveConfigAndConnect">保存并连接</button>
      </view>
    </view>
  </view>

</view>
