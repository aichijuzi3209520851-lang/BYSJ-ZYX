/* 执行器控制页样式 —— 液态玻璃主题, 卡片底色由 glass 接管层覆盖 */

/* ---------- 连接状态条(单行, 连接后才显示主题) ---------- */
.conn-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
  transition: border-color 0.3s ease;
}

/* 已连接: 翡翠绿 tint 玻璃(P15) */
.conn-bar--on.conn-bar--on {
  background-color: rgba(20, 135, 92, 0.14);
  border-color: var(--accent-line);
}

.conn-info {
  display: flex;
  align-items: center;
  min-width: 0;
}

.conn-dot--off {
  background-color: var(--ink-tertiary);
  animation: none;
}

.conn-text {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
  min-width: 0;
}

.conn-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-primary);
}

.conn-sub {
  font-size: 26rpx;
  color: var(--ink-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conn-btn {
  flex-shrink: 0;
  min-width: 112rpx;
  min-height: 60rpx;
  margin: 0 0 0 16rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--accent);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: var(--radius-pill);
  line-height: 1;
}

.conn-btn--ghost {
  background-color: rgba(255, 255, 255, 0.5);
  color: var(--alarm);
  border: 1rpx solid var(--alarm-line);
}

.conn-btn::after {
  border: none;
}

/* ---------- 模式切换卡片 ---------- */
.mode-card {
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.mode-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.mode-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink-primary);
}

/* 分段控件: 玻璃轨道 + tint 玻璃选中态(P15: 禁实色块) */
.mode-seg {
  display: flex;
  padding: 6rpx;
  background-color: rgba(255, 255, 255, 0.30);
  border: 1rpx solid var(--border-hair);
  border-radius: var(--radius-pill);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.50);
}

.mode-seg-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink-secondary);
  transition: background-color 0.2s ease, color 0.2s ease, transform 0.12s ease;
}

.mode-seg-item--on {
  background-color: rgba(20, 135, 92, 0.18);
  color: var(--accent-ink);
  font-weight: 600;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.55), inset 0 0 0 1rpx rgba(20, 135, 92, 0.22);
}

.mode-seg-hover {
  transform: translateY(2rpx);
}

/* ---------- 设备卡片 ---------- */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.device {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 20rpx 24rpx;
  min-width: 0;
  transition: border-color 0.3s ease;
}

/* 开启态: 翡翠绿 tint 玻璃, 状态一眼可见(P15) */
.device--on.device--on {
  background-color: rgba(20, 135, 92, 0.13);
  border-color: rgba(20, 135, 92, 0.18);
}

.device-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 14rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.62);
}

.device-icon {
  width: 64rpx;
  height: 64rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink-primary);
  margin-bottom: 10rpx;
}

/* 状态胶囊: 开启绿 tint / 关闭中性 */
.device-chip {
  display: flex;
  align-items: center;
  padding: 6rpx 18rpx;
  background-color: rgba(255, 255, 255, 0.42);
  border: 1rpx solid var(--border-hair);
  border-radius: 999rpx;
  margin-bottom: 18rpx;
}

.device-chip--on {
  background-color: rgba(20, 135, 92, 0.14);
  border-color: rgba(20, 135, 92, 0.20);
}

.chip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--ink-tertiary);
  margin-right: 10rpx;
}

.device-chip--on .chip-dot {
  background-color: var(--accent);
  animation: dot-breathe 2.4s ease-in-out infinite;
}

.chip-text {
  font-size: 26rpx;
  color: var(--ink-secondary);
}

.device-chip--on .chip-text {
  color: var(--accent-ink);
  font-weight: 500;
}

/* 开关按钮对: 开=主色实钮 / 关=玻璃钮; 自动模式下呈禁用态 */
.device-btns {
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.dev-btn {
  flex: 1;
  min-width: 0;   /* 解除微信 button 默认 184px 宽度下限, 允许 flex 均分 */
  min-height: 80rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--radius-pill);
  line-height: 1;
  transition: transform 0.12s ease, opacity 0.2s ease;
}

.dev-btn::after {
  border: none;
}

.dev-btn--open {
  background-color: var(--accent);
  color: #FFFFFF;
}

.dev-btn--close {
  background-color: rgba(255, 255, 255, 0.42);
  color: var(--ink-secondary);
  border: 1rpx solid var(--border-hair);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.50);
}

.dev-btn-hover {
  transform: translateY(2rpx);
}

.dev-btn--disabled {
  opacity: 0.4;
}

/* ---------- 指令日志 ---------- */
.cmd-log {
  padding: 22rpx 26rpx;
  margin-top: 20rpx;
}

.cmd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.cmd-label {
  font-size: 26rpx;
  color: var(--ink-tertiary);
}

.cmd-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink-primary);
  font-variant-numeric: tabular-nums;
}

/* ---------- 配置弹窗(strong 档玻璃底见 glass 接管层) ---------- */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(24, 39, 32, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 48rpx;
}

.modal {
  width: 100%;
  max-height: 80vh;
  padding: 40rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.modal-close {
  font-size: 44rpx;
  line-height: 1;
  color: var(--ink-tertiary);
  padding: 8rpx 12rpx;
}

/* ---------- 表单(小控件刻意实色) ---------- */
.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink-secondary);
  margin-bottom: 12rpx;
}

.field-input {
  min-height: 88rpx;
  padding: 0 24rpx;
  background-color: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--border-hair);
  border-radius: var(--radius-inner);
  font-size: 32rpx;
  color: var(--ink-primary);
}

.field-placeholder {
  color: var(--ink-tertiary);
}

/* 只读字段(指令主题) */
.field-static {
  min-height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  background-color: rgba(20, 135, 92, 0.10);
  border-radius: var(--radius-inner);
  font-size: 30rpx;
  font-weight: 500;
  color: var(--accent-ink);
}

/* ---------- 连接历史 ---------- */
.history {
  margin: 8rpx 0 28rpx;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  margin-bottom: 12rpx;
  background-color: rgba(255, 255, 255, 0.6);
  border: 1rpx solid var(--border-hair);
  border-radius: var(--radius-inner);
}

.history-info {
  display: flex;
  flex-direction: column;
}

.history-topic {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink-primary);
}

.history-del {
  font-size: 26rpx;
  color: var(--ink-tertiary);
  padding: 8rpx 12rpx;
}

/* ---------- 弹窗底部按钮 ---------- */
.modal-foot {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.modal-foot .btn-primary,
.modal-foot .btn-ghost {
  flex: 1;
  min-width: 0;   /* 解除 button 默认宽度下限, 两按钮在弹窗内均分 */
  min-height: 80rpx;
  padding: 0;
}
