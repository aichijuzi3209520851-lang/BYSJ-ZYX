/* 登入页样式 —— 液态玻璃主题
 * 设计令牌来自 app.wxss（其中已 @import ./styles/liquid-glass.wxss），本页直接复用:
 *   强调色 --accent #14875C / 墨色禁纯黑 --ink-primary / 圆角尺 --radius-card 等
 * 结构: 全幅实拍封面(压成深绿调) + 顶部品牌行 + 底部近实白输入卡
 *
 * 可读性优先(本轮重做要点):
 *   1. 卡面从"白 0.62 叠在深封面上"改为近实白 0.94 —— 0.62 时卡面被压成中灰 #a5aca9,
 *      灰字压在灰底上实测只有 2.26:1(远低于 WCAG AA 的 4.5:1), 这是"费力才看清"的根因
 *   2. 字段标签用 ink-primary(不是更淡的 secondary) + 600 字重 + 30rpx
 *   3. 输入框 34rpx / 104rpx 高, 按钮 34rpx / 104rpx, 触摸目标远超 88rpx 下限
 *   4. 去掉 .login 的 overflow: hidden —— 原实现会把底部标记裁掉半行
 *
 * 与首页协同: 封面暗部沿用首页 .hero 的 #0C2419 深绿, 名片同色系但不重复其版式
 * 动效克制: 仅卡片入场一次 + 光斑极慢呼吸, 不做位移抖动与霓虹发光 */

.login {
  position: relative;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 100vh;
  padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ---------- 封面层 ---------- */
.login-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background-color: #0C2419;
}

.login-bg-photo {
  width: 100%;
  height: 100%;
  /* 调色(降饱和 0.78 / 暗部染 #0C2419 / 竖向压暗曲线)已烘焙进 login-cover.jpg,
   * 这里不再叠 CSS filter —— image 组件的 filter 支持随基础库浮动,
   * 写了会"新库双重压暗、老库完全无效"两种画风, 交给图片本身最稳。 */
}

/* 上部留出天空层次, 下部压实承载玻璃卡与白字 */
.login-bg-scrim {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg,
    rgba(9, 26, 18, 0.52) 0%,
    rgba(9, 26, 18, 0.30) 26%,
    rgba(9, 26, 18, 0.46) 58%,
    rgba(8, 24, 17, 0.86) 100%);
}

/* 逆向光斑: 呼应封面逆光, 极慢呼吸(不做位移) */
.login-bg-glow {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background:
    radial-gradient(58% 40% at 78% 14%, rgba(255, 232, 176, 0.22) 0%, rgba(255, 232, 176, 0) 62%),
    radial-gradient(64% 34% at 18% 68%, rgba(20, 135, 92, 0.26) 0%, rgba(20, 135, 92, 0) 70%);
  animation: login-glow 9s ease-in-out infinite;
}

@keyframes login-glow {
  0%, 100% { opacity: 0.86; }
  50%      { opacity: 1; }
}

/* ---------- 顶部品牌区 ---------- */
.login-head {
  position: relative;
  z-index: 1;
  padding-top: 96rpx;
}

.login-eyebrow {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

/* 短横线代替图标: 主题禁用 emoji 图标, 用色块建立秩序 */
.login-eyebrow-bar {
  width: 44rpx;
  height: 4rpx;
  margin-right: 18rpx;
  border-radius: var(--radius-pill, 999rpx);
  background-color: rgba(255, 255, 255, 0.92);
}

.login-eyebrow-text {
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: rgba(255, 255, 255, 0.92);
}

.login-title {
  display: block;
  font-size: 80rpx;
  font-weight: 600;
  line-height: 1.14;
  letter-spacing: 6rpx;
  color: #FFFFFF;
  text-shadow: 0 2rpx 18rpx rgba(0, 0, 0, 0.42);
}

.login-sub {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.88);
  text-shadow: 0 1rpx 10rpx rgba(0, 0, 0, 0.36);
}

/* ---------- 底部输入卡 ---------- */
.login-foot {
  position: relative;
  z-index: 1;
  animation: login-rise 520ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes login-rise {
  from { opacity: 0; transform: translateY(28rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 复用 .lg-panel 的切面亮线 / 四件套 inset / blur 光学结构,
 * 但卡面改为近实白: 双类名覆盖以对齐 .lg-panel.lg-panel 的特异性,
 * 不依赖 CSS 变量继承(老基础库上更稳) */
.login-card.lg-panel {
  box-sizing: border-box;
  padding: 44rpx 40rpx 40rpx;
  border-radius: var(--radius-card, 28rpx);
  background-color: rgba(255, 255, 255, 0.94);
  box-shadow:
    inset 0 1.5rpx 0 rgba(255, 255, 255, 0.95),
    inset 0 -1rpx 2rpx rgba(30, 41, 70, 0.06),
    inset 0 0 0 1rpx rgba(30, 41, 70, 0.06),
    0 8rpx 28rpx -10rpx rgba(9, 26, 18, 0.45);
}

/* 卡首引导语: 用 ink-secondary 而非 tertiary, 保证在近实白卡面上 >=4.5:1 */
.login-card-lead {
  display: block;
  margin-bottom: 34rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-secondary, #5C7167);
}

/* ---------- 表单(尺度与传感器页同族, 但放开字号便于阅读) ---------- */
.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
}

.field-label {
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  color: var(--ink-primary, #11251C);
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 104rpx;
  padding: 0 28rpx;
  font-size: 34rpx;
  color: var(--ink-primary, #11251C);
  background-color: rgba(255, 255, 255, 0.86);
  border: 1rpx solid var(--border-hair, rgba(17, 37, 28, 0.10));
  border-radius: var(--radius-inner, 20rpx);
}

.field-placeholder {
  font-size: 30rpx;
  color: var(--ink-tertiary, #566A60);
}

.login-btn {
  width: 100%;
  min-height: 104rpx;
  margin-top: 16rpx;
  font-size: 34rpx;
  letter-spacing: 4rpx;
}

.login-mark {
  display: block;
  margin-top: 32rpx;
  font-size: 26rpx;
  letter-spacing: 1rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.78);
  text-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.34);
}
