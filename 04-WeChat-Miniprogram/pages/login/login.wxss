/* 登入页样式 —— 液态玻璃主题
 * 设计令牌来自 app.wxss（其中已 @import ./styles/liquid-glass.wxss），本页直接复用:
 *   强调色 --accent #14875C / 墨色禁纯黑 --ink-primary / 圆角尺 --radius-card 等
 * 结构: 全幅实拍封面(压成深绿调) + 顶部品牌行 + 底部玻璃输入卡
 *
 * 本轮视觉重构:
 *   1. 字阶: 64(品牌主标题) / 30(副标题) / 38(卡内标题) / 28(卡内说明) / 32(字段标签) / 34(输入与按钮)
 *      品牌名承担页面第一身份, "登入"降为卡内的 38rpx 表单标题, 不再用大字号抢主视觉
 *   2. 材质: 卡面从 0.94 近实白改为 0.70 绿白玻璃, 叠加多层高光渐变 / 1rpx 亮边 /
 *      内收阴影 / 24px 模糊, 30% 背景透出, 保留液态玻璃的半透明质感
 *   3. 可读性: 卡面最暗处(封面底部)实测 --ink-primary 8.3:1、卡内说明 #354B3F 4.7:1、
 *      输入框占位符 5.5:1、标题区白字 5.6:1、按钮白字 4.5:1, 全部达到 WCAG AA
 *   4. 顶部遮罩整体加深, 保证白色品牌名与副标题在封面高光处仍清晰
 *
 * 动效克制: 仅卡片入场一次 + 光斑极慢呼吸, 不做位移抖动与霓虹发光 */

.login {
  position: relative;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 100vh;
  padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ---------- 封面层 ---------- */
.login-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background-color: #0C2419;
}

.login-bg-photo {
  width: 100%;
  height: 100%;
  /* 调色(降饱和 0.78 / 暗部染 #0C2419 / 竖向压暗曲线)已烘焙进 login-cover.jpg,
   * 这里不再叠 CSS filter —— image 组件的 filter 支持随基础库浮动,
   * 写了会"新库双重压暗、老库完全无效"两种画风, 交给图片本身最稳。 */
}

/* 双轴遮罩: 竖向压暗承载白字与玻璃卡, 左侧再压一层保证标题落在高光外也清晰 */
.login-bg-scrim {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background:
    linear-gradient(90deg,
      rgba(6, 20, 13, 0.42) 0%,
      rgba(6, 20, 13, 0.12) 58%,
      rgba(6, 20, 13, 0) 100%),
    linear-gradient(180deg,
      rgba(9, 26, 18, 0.62) 0%,
      rgba(9, 26, 18, 0.52) 30%,
      rgba(9, 26, 18, 0.56) 60%,
      rgba(8, 24, 17, 0.90) 100%);
}

/* 逆向光斑: 呼应封面逆光, 极慢呼吸(不做位移) */
.login-bg-glow {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background:
    radial-gradient(58% 40% at 78% 14%, rgba(255, 232, 176, 0.22) 0%, rgba(255, 232, 176, 0) 62%),
    radial-gradient(64% 34% at 18% 68%, rgba(20, 135, 92, 0.26) 0%, rgba(20, 135, 92, 0) 70%);
  animation: login-glow 9s ease-in-out infinite;
}

@keyframes login-glow {
  0%, 100% { opacity: 0.86; }
  50%      { opacity: 1; }
}

/* ---------- 顶部品牌区 ---------- */
.login-head {
  position: relative;
  z-index: 1;
  padding-top: 96rpx;
}

.login-brand-bar {
  width: 48rpx;
  height: 4rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-pill, 999rpx);
  background-color: rgba(255, 255, 255, 0.94);
}

.login-brand {
  display: block;
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 1rpx;
  color: #FFFFFF;
  text-shadow: 0 3rpx 24rpx rgba(0, 0, 0, 0.48);
}

.login-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.90);
  text-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.40);
}

/* ---------- 底部输入卡 ---------- */
.login-foot {
  position: relative;
  z-index: 1;
  animation: login-rise 520ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes login-rise {
  from { opacity: 0; transform: translateY(28rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 液态玻璃卡: 0.70 绿白玻璃叠在深封面上, 30% 背景透出
 * 高光 / 折射 / 切面亮线 / 内收阴影四层结构, blur 仅支持环境生效,
 * 不支持时靠 0.70 填充与亮边维持材质, 文字对比度不依赖 blur */
.login-card.lg-panel {
  box-sizing: border-box;
  padding: 44rpx 40rpx 40rpx;
  border-radius: var(--radius-card, 28rpx);
  background-color: rgba(250, 255, 252, 0.70);
  background-image:
    linear-gradient(135deg, rgba(255, 255, 255, 0.34) 0%, rgba(255, 255, 255, 0) 30%),
    linear-gradient(315deg, rgba(188, 232, 208, 0.20) 0%, rgba(188, 232, 208, 0) 46%),
    radial-gradient(120% 80% at 8% 0%, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 52%);
  background-repeat: no-repeat, no-repeat, no-repeat;
  background-size: 100% 100%, 100% 100%, 100% 100%;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  outline: 1rpx solid rgba(255, 255, 255, 0.16);
  outline-offset: -2rpx;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.95),
    inset 0 -3rpx 8rpx rgba(10, 30, 20, 0.10),
    inset 0 0 0 1rpx rgba(255, 255, 255, 0.24),
    0 24rpx 60rpx rgba(4, 18, 12, 0.34);
  -webkit-backdrop-filter: blur(26px) saturate(160%) brightness(1.06);
  backdrop-filter: blur(26px) saturate(160%) brightness(1.06);
}

/* 卡内标题: 账号登入, 38rpx 表单层级, 不抢品牌主视觉 */
.login-card-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  color: var(--ink-primary, #11251C);
}

/* 卡首引导语: 用压深的卡内次级色, 在 0.70 玻璃最暗处仍有 4.7:1 */
.login-card-lead {
  display: block;
  margin-bottom: 26rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #354B3F;
}

/* ---------- 表单(尺度与传感器页同族, 但放开字号便于阅读) ---------- */
.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 32rpx;
}

.field-label {
  margin-bottom: 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  color: var(--ink-primary, #11251C);
}

.field-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 104rpx;
  padding: 0 28rpx;
  font-size: 34rpx;
  color: var(--ink-primary, #11251C);
  background-color: rgba(255, 255, 255, 0.66);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: var(--radius-inner, 20rpx);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92),
    0 2rpx 8rpx rgba(4, 18, 12, 0.05);
}

.field-placeholder {
  font-size: 34rpx;
  color: var(--ink-tertiary, #4A5E54);
}

.login-btn {
  width: 100%;
  min-height: 104rpx;
  margin-top: 16rpx;
  font-size: 34rpx;
  letter-spacing: 2rpx;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.18),
    0 12rpx 28rpx rgba(20, 135, 92, 0.24);
}

.login-mark {
  display: block;
  margin-top: 32rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.82);
  text-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.36);
}
