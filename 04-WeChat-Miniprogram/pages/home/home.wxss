/* 首页样式 —— 液态玻璃主题, 通用卡片底色由 glass 接管层覆盖 */

/* 首页为纵向留白结构: 封面 / 署名 / 双入口 */
.home {
  display: flex;
  flex-direction: column;
  padding-top: 0;
}

/* ---------- 封面(全幅实拍轮播) ---------- */
.hero {
  position: relative;
  height: 560rpx;
  margin: 0 -32rpx 22rpx;
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
  background-color: #0C2419;
}

.hero-swiper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-swiper swiper-item {
  position: relative;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 上部轻压暗保证天空层次, 下部压实承载白字 */
.hero-scrim {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg,
    rgba(9, 26, 18, 0.28) 0%,
    rgba(9, 26, 18, 0.04) 36%,
    rgba(9, 26, 18, 0.38) 70%,
    rgba(9, 26, 18, 0.82) 100%);
}

/* 关键: 文字层只占底部一条, 且不接收触摸, 手势穿透给 swiper */
.hero-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  box-sizing: border-box;
  padding: 0 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  pointer-events: none;
}

.hero-copy {
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 60rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1.25;
  color: #FFFFFF;
  text-shadow: 0 2rpx 16rpx rgba(9, 26, 18, 0.4);
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.80);
}

/* 胶囊指示点: 激活态拉长 */
.hero-dots {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}

.hero-dot-ind {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.42);
  margin-right: 12rpx;
  transition: width 0.25s ease, background-color 0.25s ease;
}

.hero-dot-ind--on {
  width: 36rpx;
  background-color: #FFFFFF;
}

/* ---------- 开发者署名(深绿名片, 首页第二视觉焦点; 刻意保留实色锚点) ---------- */
.author {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(135deg, rgba(14, 60, 42, 0.94) 0%, rgba(20, 89, 61, 0.90) 100%);
  box-shadow: 0 14rpx 32rpx rgba(14, 60, 42, 0.18);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

.author-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.86);
}

.author-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-left: 24rpx;
}

.author-name {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #FFFFFF;
}

.author-role {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.68);
}

.author-tag {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: #E9FFF3;
  background-color: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}

/* ---------- 双入口(玻璃卡, 主次分明) ---------- */
.entry-grid {
  display: grid;
  grid-template-columns: 1.12fr 0.88fr;
  gap: 20rpx;
}

.entry {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 236rpx;
  padding: 26rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: var(--radius-card);
  border: 1rpx solid var(--border-hair);
  transition: transform 0.12s ease;
}

/* 数据入口的翡翠绿 tint 玻璃(P15: tint 而非实色) */
.entry--data.entry--data {
  background-color: rgba(20, 135, 92, 0.14);
}

.entry--control.entry--control {
  background-color: var(--lg-fill, rgba(255, 255, 255, 0.50));
}

.entry--hover {
  transform: translateY(2rpx);
}

.entry-icon-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.62);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.62), 0 4rpx 12rpx rgba(17, 37, 28, 0.06);
}

.entry--control .entry-icon-wrap {
  background-color: rgba(255, 255, 255, 0.46);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.62);
}

.entry-icon {
  width: 52rpx;
  height: 52rpx;
}

.entry-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

.entry-title {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  color: var(--ink-primary);
}

.entry-meta {
  margin-top: 2rpx;
  font-size: 26rpx;
  color: var(--ink-secondary);
}

/* ---------- 退出登录(低调文字入口, 与双入口拉开层级) ---------- */
.logout-row {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  min-height: 72rpx;
  margin-top: 18rpx;
  padding: 0 32rpx;
  border-radius: var(--radius-pill);
}

.logout-row--hover {
  background-color: var(--accent-soft);
}

.logout-text {
  font-size: 26rpx;
  letter-spacing: 1rpx;
  color: var(--ink-tertiary);
}
