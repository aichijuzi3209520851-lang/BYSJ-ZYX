/* 首页样式 —— 遵循 app.wxss 设计令牌 */

.container {
  padding-top: 0;
}

/* ---------- 顶部品牌区(非居中对称: 左对齐 + 大留白) ---------- */
.hero {
  margin: 0 -32rpx 28rpx;
  padding: 64rpx 48rpx 56rpx;
  background-color: var(--accent);
  border-radius: 0 0 40rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  padding: 10rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  margin-bottom: 32rpx;
}

.hero-dot {
  background-color: #FFFFFF;
  width: 12rpx;
  height: 12rpx;
}

.hero-badge-text {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  line-height: 1.35;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 3rpx;
}

/* ---------- 欢迎卡片 ---------- */
.welcome {
  padding: 32rpx 32rpx;
  margin-bottom: 24rpx;
}

.welcome-text {
  font-size: 28rpx;
  color: var(--ink-secondary);
  line-height: 1.8;
}

/* ---------- 功能行 ---------- */
.feature {
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}

.feature-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.feature-body {
  display: flex;
  flex-direction: column;
  margin-left: 28rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-primary);
}

.feature-desc {
  margin-top: 4rpx;
}

.feature-divider {
  height: 1rpx;
  background-color: var(--border-hair);
}

/* ---------- 系统信息条 ---------- */
.meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 20rpx;
  margin-bottom: 24rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.meta-label {
  font-size: 22rpx;
  color: var(--ink-tertiary);
  margin-bottom: 6rpx;
}

.meta-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-primary);
  font-variant-numeric: tabular-nums;
}

.meta-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: var(--border-hair);
}

/* ---------- 开发者 ---------- */
.author {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-bottom: 40rpx;
}

.author-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 2rpx solid var(--bg-wash);
}

.author-body {
  display: flex;
  flex-direction: column;
  margin-left: 24rpx;
}

.author-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-primary);
}

/* ---------- CTA ---------- */
.cta {
  width: 100%;
  border-radius: var(--radius-inner);
}
