<!-- 首页 -->
<view class="page-bg" aria-hidden="true">
  <image class="page-bg-photo" src="/images/bg-home.jpg" mode="aspectFill" />
  <view class="page-bg-scrim"></view>
  <view class="page-bg-glow"></view>
</view>

<view class="container home">

  <!-- 封面: 温室实拍轮播, 文字压在下沿暗区 -->
  <view class="hero">
    <swiper class="hero-swiper" autoplay="{{true}}" interval="5000" duration="450"
      circular="{{true}}" bindchange="onSlideChange">
      <swiper-item wx:for="{{slides}}" wx:key="id">
        <image class="hero-bg" src="{{item.src}}" mode="aspectFill" />
        <view class="hero-scrim"></view>
      </swiper-item>
    </swiper>

    <!-- pointer-events: none 让触摸穿透到下层 swiper, 恢复手动滑动 -->
    <view class="hero-body">
      <view class="hero-copy">
        <text class="hero-title">智能温室</text>
        <text class="hero-sub">STM32 + MQTT 环境监测</text>
      </view>
      <view class="hero-dots">
        <view wx:for="{{slides}}" wx:key="id"
          class="hero-dot-ind {{currentSlide === index ? 'hero-dot-ind--on' : ''}}"></view>
      </view>
    </view>
  </view>

  <!-- 开发者署名(深绿名片, 视觉锚点) -->
  <view class="author">
    <image class="author-avatar" src="/ICON/周颖暄.jpg" mode="aspectFill" />
    <view class="author-body">
      <text class="author-name">周颖暄</text>
      <text class="author-role">毕业设计 · 物联网方向</text>
    </view>
    <text class="author-tag">作者</text>
  </view>

  <!-- 双入口: 环境数据 / 设备控制 -->
  <view class="entry-grid">
    <view class="entry entry--data" hover-class="entry--hover" bindtap="goToSensor">
      <view class="entry-icon-wrap">
        <image class="entry-icon" src="/ICON/温度.png" mode="aspectFit" />
      </view>
      <view class="entry-copy">
        <text class="entry-title">环境数据</text>
        <text class="entry-meta">实时监测</text>
      </view>
    </view>

    <view class="entry entry--control" hover-class="entry--hover" bindtap="goToActuator">
      <view class="entry-icon-wrap">
        <image class="entry-icon" src="/ICON/风扇-开状态.png" mode="aspectFit" />
      </view>
      <view class="entry-copy">
        <text class="entry-title">设备控制</text>
        <text class="entry-meta">天窗 · 风扇</text>
      </view>
    </view>
  </view>

</view>
